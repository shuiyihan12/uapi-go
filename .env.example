# Example environment variables for the UAPI daemon.
# Copy to .env and fill in real values; .env is git-ignored and never committed.

# ===== Request-level (NOT configured here; callers send these in HTTP request headers) =====
# Auth: callers send Authorization in every request header (e.g. Basic xxx / Bearer xxx);
# the gateway forwards it verbatim to UAPI.
# Region: callers send X-UAPI-Region (americas / apac / emea) in every request header,
# used to build the Production endpoint.
#   When X-UAPI-Region is absent, UAPI_ENDPOINT below is used as the default endpoint.

# ===== Optional: default endpoint prefix =====
# Default GDS endpoint prefix (used when no region is specified); the service layer
# appends AirService / UniversalRecordService etc. automatically.
# When unset, defaults to the apac production environment:
# https://apac.universal-api.travelport.com/B2BGateway/connect/uAPI
UAPI_ENDPOINT="https://apac.universal-api.travelport.com/B2BGateway/connect/uAPI"
# Request-level business parameters (TargetBranch, ProviderCode, OriginApplication,
# CIDBNumber, ...) are no longer injected from configuration; API callers provide
# them explicitly in each request body (see the per-endpoint JSON structures).

# ===== Optional: HTTP transport timeouts (milliseconds; bound ONE SOAP call's network time) =====
# Max time to establish the TCP/TLS connection; maps to http.Transport.DialContext.Timeout.
UAPI_CONNECTION_TIMEOUT="45000"
# After connecting, max wait for the GDS to start returning response headers;
# maps to http.Transport.ResponseHeaderTimeout.
UAPI_READ_TIMEOUT="90000"
# Overall timeout of a single SOAP call (hard cap over connect+send+read+transfer);
# maps to http.Client.Timeout.
UAPI_REQUEST_TIMEOUT="90000"

# Note: the three values above only bound a single call; multi-page flows (e.g.
# HotelDetails' NextResultReference) have a separate business-level cumulative
# timeout of 40s (constant defaultHotelDetailsPageTimeout) — the two are
# orthogonal. This project does not retry: any single failed call returns
# immediately and is handled by the caller (e.g. surfacing the GDS business
# error).

# ===== Optional: outbound keep-alive connection pool =====
# Warm (idle) connections to the GDS kept for reuse, avoiding a TCP+TLS
# re-handshake on every request. The per-host pool is capped by the global
# value; only relevant under sustained concurrency above the defaults.
# UAPI_MAX_IDLE_CONNS="100"
# UAPI_MAX_IDLE_CONNS_PER_HOST="100"

# ===== Optional: TLS certificate verification =====
# Upstream TLS certificates are verified by default. Only set this to 1 for
# private environments with self-signed certificates; keep it unset in production.
# UAPI_SKIP_TLS_VERIFY="1"

# ===== Go daemon runtime configuration =====
# Business API and ops endpoints (/health, /ready, /stats, /metrics) share one port.
UAPI_ENV="test"
PORT="8080"
